{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package closeout map",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "status",
    "important_artifacts",
    "ancestor_disposition",
    "successor_start_here"
  ],
  "properties": {
    "important_artifacts": {
      "type": "array",
      "minItems": 1
    },
    "ancestor_disposition": {
      "type": "array",
      "minItems": 1
    },
    "successor_start_here": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
